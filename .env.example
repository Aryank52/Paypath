# PayPath Environment Configuration

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME="PayPath"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Primary: PostgreSQL with asyncpg (Render / Production)
# Fallback: SQLite with aiosqlite for zero-setup local dev
DATABASE_URL=sqlite+aiosqlite:///./paypath.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paypath

# Redis Cache & Rate Limiting (optional in dev, defaults to in-memory)
REDIS_URL=redis://localhost:6379/0

# PayPal Sandbox Credentials (Required for Live Sandbox transactions)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# AI Provider Configuration (Optional - fallback mock engine used if empty)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Feature Flags
ENABLE_VOICE=true
ENABLE_SHOPPING=true
ENABLE_CHANNEL3=false
ENABLE_AGENTIC_PURCHASE=true
ENABLE_RECOVERY=true
ENABLE_RECLAIM=true
ENABLE_MULTI_MERCHANT=true
ENABLE_EMAIL=false
ENABLE_ZAPIER=false
ENABLE_ELASTIC=false
ENABLE_BRYNTUM=false
ENABLE_KERNEL=false
